# Spring profile
SPRING_PROFILES_ACTIVE=prod

# Railway provides these for MySQL service; keep names exactly as used by Spring
SPRING_DATASOURCE_URL=jdbc:mysql://<host>:<port>/<database>?useSSL=true&requireSSL=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=<username>
SPRING_DATASOURCE_PASSWORD=<password>
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# JWT
APP_JWT_SECRET=<at-least-32-char-secret>
APP_JWT_ACCESS_TOKEN_VALIDITY_MS=3600000
APP_JWT_REFRESH_TOKEN_VALIDITY_MS=604800000

# CORS and WebSocket origins (comma-separated)
APP_CORS_ALLOWED_ORIGINS=https://<your-project>.vercel.app
APP_WS_ALLOWED_ORIGINS=https://<your-project>.vercel.app

# File upload storage (recommended: Railway volume mount)
APP_FILE_UPLOAD_DIR=/data/uploads

# EmailJS Configuration (works on Railway Free/Trial without SMTP restrictions)
# Get these from https://dashboard.emailjs.com/admin
# 1. Service ID: Create a service and copy the Service ID
# 2. Template ID: Create an email template and copy the Template ID
# 3. Public Key: Find in Account > API Keys (for frontend use, optional here)
# 4. Private Key: Find in Account > API Keys (REQUIRED for backend/server-side auth)
#    The Private Key is sent as "user_id" in the API request for authentication
APP_MAIL_EMAILJS_SERVICE_ID=<your-service-id>
APP_MAIL_EMAILJS_TEMPLATE_ID=<your-template-id>
APP_MAIL_EMAILJS_PUBLIC_KEY=<your-public-key>
APP_MAIL_EMAILJS_PRIVATE_KEY=<your-private-key>
APP_MAIL_NOTIFICATION_TO=<admin-notification-email>
APP_MAIL_BRAND_NAME=Lifewood
APP_MAIL_BRAND_WEBSITE=https://www.lifewood.com

