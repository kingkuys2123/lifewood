# Spring profile
SPRING_PROFILES_ACTIVE=prod

# Railway provides these for MySQL service; keep names exactly as used by Spring
SPRING_DATASOURCE_URL=jdbc:mysql://<host>:<port>/<database>?useSSL=true&requireSSL=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=<username>
SPRING_DATASOURCE_PASSWORD=<password>
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# JWT
APP_JWT_SECRET=<at-least-32-char-secret>
APP_JWT_ACCESS_TOKEN_VALIDITY_MS=3600000
APP_JWT_REFRESH_TOKEN_VALIDITY_MS=604800000

# CORS and WebSocket origins (comma-separated)
APP_CORS_ALLOWED_ORIGINS=https://<your-project>.vercel.app
APP_WS_ALLOWED_ORIGINS=https://<your-project>.vercel.app

# File upload storage (recommended: Railway volume mount)
APP_FILE_UPLOAD_DIR=/data/uploads

# SMTP mail
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=<email-username>
SPRING_MAIL_PASSWORD=<email-app-password>
APP_MAIL_NOTIFICATION_TO=<notification-email>
APP_MAIL_BRAND_NAME=Lifewood
APP_MAIL_BRAND_WEBSITE=https://www.lifewood.com

